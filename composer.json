{
    "name": "xililo/namesilo",
    "description": "A PHP Composer package for the NameSilo API.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "api",
        "composer",
        "dns",
        "domains",
        "namesilo",
        "php",
        "registrar"
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Xililo\\Namesilo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xililo\\Namesilo\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
